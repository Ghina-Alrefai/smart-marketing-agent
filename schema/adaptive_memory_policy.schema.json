{
  "$defs": {
    "AgentType": {
      "enum": [
        "CAMPAIGN_AGENT",
        "COPYWRITER_AGENT",
        "DESIGNER_AGENT",
        "SCHEDULER_AGENT"
      ],
      "title": "AgentType",
      "type": "string"
    },
    "PolicyReviewDecision": {
      "enum": [
        "renew",
        "modify",
        "suspend",
        "expire",
        "insufficient_evidence"
      ],
      "title": "PolicyReviewDecision",
      "type": "string"
    },
    "Recommendation": {
      "enum": ["prefer", "avoid", "monitor"],
      "title": "Recommendation",
      "type": "string"
    },
    "PolicyRule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "feature_name": {
          "title": "Feature Name",
          "type": "string"
        },
        "feature_value": {
          "default": null,
          "title": "Feature Value"
        },
        "conditions": {
          "additionalProperties": true,
          "title": "Conditions",
          "type": "object"
        },
        "source_insight_id": {
          "title": "Source Insight Id",
          "type": "string"
        },
        "confidence_0_1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence 0 1",
          "type": "number"
        },
        "recommendation": {
          "anyOf": [
            {"$ref": "#/$defs/Recommendation"},
            {"type": "null"}
          ],
          "default": null
        },
        "source_support_count": {
          "default": 0,
          "minimum": 0,
          "title": "Source Support Count",
          "type": "integer"
        },
        "priority": {
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "is_hard_constraint": {
          "default": false,
          "title": "Is Hard Constraint",
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "feature_name",
        "source_insight_id",
        "confidence_0_1",
        "priority"
      ],
      "title": "PolicyRule",
      "type": "object"
    },
    "PolicyStatus": {
      "enum": [
        "draft",
        "active",
        "paused",
        "expired",
        "deprecated",
        "rejected"
      ],
      "title": "PolicyStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "family_id": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null,
      "title": "Family Id"
    },
    "brand_id": {
      "title": "Brand Id",
      "type": "string"
    },
    "target_agent": {
      "$ref": "#/$defs/AgentType"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/PolicyRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "source_insight_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Insight Ids",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/PolicyStatus",
      "default": "draft"
    },
    "human_approval_required": {
      "default": true,
      "title": "Human Approval Required",
      "type": "boolean"
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "supersedes_policy_id": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null
    },
    "replacement_policy_id": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null
    },
    "valid_from": {
      "anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}],
      "default": null
    },
    "valid_until": {
      "anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}],
      "default": null
    },
    "next_review_at": {
      "anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}],
      "default": null
    },
    "last_review_at": {
      "anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}],
      "default": null
    },
    "review_interval_days": {
      "default": 30,
      "minimum": 1,
      "type": "integer"
    },
    "review_grace_days": {
      "default": 15,
      "minimum": 0,
      "type": "integer"
    },
    "minimum_review_posts": {
      "default": 8,
      "minimum": 1,
      "type": "integer"
    },
    "insufficient_review_count": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "last_review_decision": {
      "anyOf": [
        {"$ref": "#/$defs/PolicyReviewDecision"},
        {"type": "null"}
      ],
      "default": null
    },
    "last_review_reason": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null
    },
    "expiration_reason": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "brand_id",
    "target_agent",
    "version"
  ],
  "title": "Policy",
  "type": "object"
}
