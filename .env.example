GOOGLE_API_KEY=your-google-api-key-here
# Optional for faster first-time public-model downloads from Hugging Face.
# Keep real tokens only in `.env`; never commit or package that file.
HF_TOKEN=
DATABASE_URL=sqlite:///./marketing_os.db
SECRET_KEY=change-me-in-production
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── Google Sign-In (OAuth 2.0) — from Google Cloud Console ───────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# يجب أن يطابق GOOGLE_CLIENT_ID؛ يقرأه Vite أثناء بناء الواجهة.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Fixed super-admin account ───────────────────────────────────────────────
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin2026

# Brand-DNA + Adaptive Memory
BRAND_DNA_ROOT=.
ADAPTIVE_MEMORY_DB=./outputs/adaptive_memory/app.db
# Load both saved bundles and embedding encoders once when the API process starts.
# Run `python scripts/preload_models.py` once beforehand to populate the disk cache.
BRAND_DNA_PRELOAD_MODELS=true
BRAND_DNA_GENERATION_MAX_ATTEMPTS=3
BRAND_DNA_MIN_CANDIDATE_PROBABILITY=0.50
BRAND_DNA_MODEL_BRAND_KEYS=al-boraq
COLD_START_MIN_TRAINING_POSTS=30
DEFAULT_SCHEDULE_HOUR=20

# Learned-policy health review (MVP thresholds are configurable)
POLICY_REVIEW_ENABLED=true
POLICY_REVIEW_CHECK_INTERVAL_SECONDS=86400
POLICY_REVIEW_INTERVAL_DAYS=30
POLICY_REVIEW_GRACE_DAYS=15
POLICY_REVIEW_MIN_POSTS=8
POLICY_REVIEW_DEFERRAL_DAYS=14
POLICY_REVIEW_MAX_INSUFFICIENT_REVIEWS=2
POLICY_REVIEW_RENEW_MIN_SUCCESS_RATE=0.60
POLICY_REVIEW_MODIFY_MIN_SUCCESS_RATE=0.50
POLICY_REVIEW_EXPIRE_BELOW_SUCCESS_RATE=0.35

# Logging and diagnostics
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_TO_FILE=true
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
# Enable only temporarily during local DB diagnosis; it can print SQL values.
SQL_ECHO=false
