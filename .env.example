# ════════════════════════════════════════════════════════════════════════════
#  قالب الإعدادات — انسخه إلى .env واملأ القيم الحقيقية:
#      cp .env.example .env
#  يقرأه الطرفان معاً:
#    • FastAPI  عبر config.py  (env_file=".env")
#    • Vite     عبر vite.config.js (envDir: '..') — لذلك متغيّرات VITE_ هنا
#  لا تُنشئ ملف .env داخل frontend/ فلن يُقرأ إطلاقاً.
#  ملف .env نفسه غير متتبَّع في git — لا تشاركه ولا ترفعه.
# ════════════════════════════════════════════════════════════════════════════

# ── البيئة ──────────────────────────────────────────────────────────────────
# development = تشغيل محلي | production = يرفض الإقلاع بالقيم الافتراضية
APP_ENV=development

# ── الذكاء الاصطناعي (Gemini) ───────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# رمز Hugging Face — اختياري، يسرّع أول تنزيل للنماذج العامة
HF_TOKEN=

# ── قاعدة البيانات والملفات ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./marketing_os.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── الأمان ──────────────────────────────────────────────────────────────────
# مفتاح توقيع رموز الجلسة (JWT) — تغييره يُبطل كل الجلسات الحالية
SECRET_KEY=change-me-in-production
SESSION_TOKEN_DAYS=30

# ── تسجيل الدخول عبر Google (OAuth 2.0) ─────────────────────────────────────
# القيمتان التاليتان يجب أن تتطابقا دائماً:
#   GOOGLE_CLIENT_ID       ← يستخدمه الخادم للتحقق من هوية المستخدم
#   VITE_GOOGLE_CLIENT_ID  ← تقرأه الواجهة لعرض زر Google (بدونه لا يعمل الزر)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── حساب المشرف الثابت ──────────────────────────────────────────────────────
# تغيير كلمة المرور هنا يُحدّثها تلقائياً في قاعدة البيانات عند الإقلاع
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin2026
ADMIN_NAME=Super Admin

# ── Brand-DNA والذاكرة التكيّفية ────────────────────────────────────────────
BRAND_DNA_ROOT=.
ADAPTIVE_MEMORY_DB=./outputs/adaptive_memory/app.db
BRAND_DNA_PRELOAD_MODELS=true
BRAND_DNA_GENERATION_MAX_ATTEMPTS=3
BRAND_DNA_MIN_CANDIDATE_PROBABILITY=0.50
BRAND_DNA_MODEL_BRAND_KEYS=al-boraq
COLD_START_MIN_TRAINING_POSTS=30
DEFAULT_SCHEDULE_HOUR=20

# ── مراجعة صحّة السياسات المتعلَّمة ──────────────────────────────────────────
POLICY_REVIEW_ENABLED=true
POLICY_REVIEW_CHECK_INTERVAL_SECONDS=86400
POLICY_REVIEW_INTERVAL_DAYS=30
POLICY_REVIEW_GRACE_DAYS=15
POLICY_REVIEW_MIN_POSTS=8
POLICY_REVIEW_DEFERRAL_DAYS=14
POLICY_REVIEW_MAX_INSUFFICIENT_REVIEWS=2
POLICY_REVIEW_RENEW_MIN_SUCCESS_RATE=0.60
POLICY_REVIEW_MODIFY_MIN_SUCCESS_RATE=0.50
POLICY_REVIEW_EXPIRE_BELOW_SUCCESS_RATE=0.35

# ── السجلّات والتشخيص ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_TO_FILE=true
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
# فعّله مؤقتاً فقط عند تشخيص قاعدة البيانات — قد يطبع قيم SQL الحساسة
SQL_ECHO=false
