GOOGLE_API_KEY=your-google-api-key-here
DATABASE_URL=sqlite:///./marketing_os.db
SECRET_KEY=change-me-in-production
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Brand-DNA + Adaptive Memory
BRAND_DNA_ROOT=.
ADAPTIVE_MEMORY_DB=./outputs/adaptive_memory/app.db
BRAND_DNA_GENERATION_MAX_ATTEMPTS=3
BRAND_DNA_MIN_CANDIDATE_PROBABILITY=0.50
BRAND_DNA_MODEL_BRAND_KEYS=al-boraq
COLD_START_MIN_TRAINING_POSTS=30
DEFAULT_SCHEDULE_HOUR=20

# Logging and diagnostics
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_TO_FILE=true
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
# Enable only temporarily during local DB diagnosis; it can print SQL values.
SQL_ECHO=false
